{
    "name": "@inseefr/trevas",
    "version": "1.1.1",
    "description": "TypeScript engine for the [Validation and Transformation Language](https://sdmx.org/?page_id=5096)",
    "repository": {
        "type": "git",
        "url": "https://github.com/InseeFr/Trevas-TS"
    },
    "license": "MIT",
    "author": "INSEE (http://www.insee.fr)",
    "packageManager": "pnpm@12.10.1",
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint:check": "eslint .",
        "lint": "pnpm run lint:check -- --fix",
        "_format": "prettier '**/*.{js,ts,tsx,json,md}'",
        "format": "pnpm run _format -- --write",
        "format:check": "pnpm run _format -- --list-different",
        "prepare": "husky"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix"
        ],
        "*.{ts,tsx,json,md}": [
            "prettier --write"
        ]
    },
    "files": [
        "dist",
        "!dist/tsconfig.tsbuildinfo",
        "!dist/tests/**",
        "!dist/stories/**",
        "!dist/**/*.spec.js",
        "!dist/**/*.spec.d.ts",
        "!dist/**/*.spec.js.map"
    ],
    "keywords": [],
    "homepage": "https://github.com/InseeFr/Trevas-TS",
    "contributor": [
        {
            "name": "Hadrien Kohl",
            "email": "hadrien.kohl@gmail.com"
        },
        {
            "name": "Nicolas Laval",
            "email": "nicolas.laval@making-sense.info"
        },
        {
            "name": "Renaud Genevois",
            "email": "renaud.genevois@insee.fr"
        }
    ],
    "devDependencies": {
        "@making-sense/antlr-editor": "^2.9.5",
        "@making-sense/vtl-2-1-monaco-tools-ts": "^1.0.2",
        "@storybook/addon-docs": "10.6.1",
        "@storybook/addon-links": "10.6.1",
        "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
        "@storybook/react": "10.6.1",
        "@storybook/react-webpack5": "10.6.1",
        "@types/lodash.isequal": "^4.5.8",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitest/coverage-v8": "^5.0.3",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "10.6.1",
        "husky": "^9.1.7",
        "json-antlr-tools-ts": "^1.0.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "storybook": "10.6.1",
        "storybook-dark-mode": "^5.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.3",
        "webpack": "5.111.1"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "@making-sense/antlr4ng": "^3.0.16",
        "@making-sense/vtl-2-1-antlr-tools-ts": "^1.0.6",
        "danfojs": "1.1.2",
        "date-fns": "^4.4.0",
        "lodash.isequal": "^4.5.0",
        "rand-seed": "^3.0.0"
    }
}
