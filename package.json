{
    "name": "@inseefr/trevas",
    "version": "1.0.2",
    "description": "TypeScript engine for the [Validation and Transformation Language](https://sdmx.org/?page_id=5096)",
    "repository": {
        "type": "git",
        "url": "https://github.com/InseeFr/Trevas-TS"
    },
    "license": "MIT",
    "author": "INSEE (http://www.insee.fr)",
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint:check": "eslint .",
        "lint": "npm run lint:check -- --fix",
        "_format": "prettier '**/*.{js,ts,tsx,json,md}'",
        "format": "npm run _format -- --write",
        "format:check": "npm run _format -- --list-different",
        "prepare": "husky"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./*": "./dist/*.js"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix"
        ],
        "*.{ts,tsx,json,md}": [
            "prettier --write"
        ]
    },
    "files": [
        "src/",
        "dist/",
        "!dist/tsconfig.tsbuildinfo"
    ],
    "keywords": [],
    "homepage": "https://github.com/InseeFr/Trevas-TS",
    "contributor": [
        {
            "name": "Hadrien Kohl",
            "email": "hadrien.kohl@gmail.com"
        },
        {
            "name": "Nicolas Laval",
            "email": "nicolas.laval@making-sense.info"
        },
        {
            "name": "Renaud Genevois",
            "email": "renaud.genevois@insee.fr"
        }
    ],
    "devDependencies": {
        "@making-sense/antlr-editor": "^2.9.4",
        "@making-sense/vtl-2-1-monaco-tools-ts": "^1.0.2",
        "@storybook/addon-docs": "10.5.10",
        "@storybook/addon-links": "10.5.10",
        "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
        "@storybook/react": "10.5.10",
        "@storybook/react-webpack5": "10.5.10",
        "@types/lodash.isequal": "^4.5.8",
        "@types/node": "^22.15.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-storybook": "10.5.10",
        "husky": "^9.1.7",
        "json-antlr-tools-ts": "^1.0.0",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "storybook": "10.5.10",
        "storybook-dark-mode": "^5.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.11",
        "webpack": "5.109.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "@making-sense/antlr4ng": "^3.0.16",
        "@making-sense/vtl-2-1-antlr-tools-ts": "^1.0.6",
        "danfojs": "^1.1.2",
        "date-fns": "^4.4.0",
        "lodash.isequal": "^4.5.0",
        "rand-seed": "^2.1.7"
    },
    "resolutions": {
        "@making-sense/antlr4ng": "^3.0.16",
        "monaco-editor": "^0.56.0"
    }
}
